{
  "name": "prompt-optimizer",
  "compatibility_date": "2026-05-27",
  "main": "cf-worker.mjs",
  "ai": { "binding": "AI" },
  "build": {
    "command": "VITE_CF_PROXY_ONLY=true pnpm -F @prompt-optimizer/core build && VITE_CF_PROXY_ONLY=true pnpm -F @prompt-optimizer/ui build && VITE_CF_PROXY_ONLY=true pnpm -F @prompt-optimizer/web build"
  },
  "assets": {
    "directory": "packages/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "single-page-application"
  }
}
